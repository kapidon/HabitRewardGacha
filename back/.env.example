# 実行環境設定
# "development": ローカル開発環境（/docsなどのAPIドキュメントを公開）
# "production": 本番環境（/docsなどのAPIドキュメントを非公開）
ENVIRONMENT=development

# ストレージタイプ設定
# "s3": 本番環境用のAWS S3
# "minio": ローカル開発環境用のMinIO
STORAGE_TYPE=minio

# AWS S3設定
# 本番環境で使用するS3バケット名
AWS_S3_BUCKET=your-s3-bucket-name
# CloudFrontのドメイン名（例: xxxxxx.cloudfront.net）
AWS_CLOUDFRONT_DOMAIN=your-cloudfront-domain.cloudfront.net

# MinIO設定（ローカル開発環境用）
# MinIOサーバーのエンドポイント（デフォルト: http://localhost:9000）
MINIO_ENDPOINT=http://localhost:9000
# MinIOのアクセスキー（各自のローカルMinIO環境に合わせて設定）
MINIO_ACCESS_KEY=your-local-minio-access-key
# MinIOのシークレットキー（各自のローカルMinIO環境に合わせて設定）
MINIO_SECRET_KEY=your-local-minio-secret-key
# MinIOのバケット名
MINIO_BUCKET=gacha

# PostgreSQL設定
DATABASE_URL=postgresql://user:password@localhost:5432/reward_gacha

# 認証設定
# APIキー（React Nativeアプリからのアクセス認証用）
API_KEY=your-api-key
